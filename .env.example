# ============================================================================
# ACTIVE ENVIRONMENT SELECTOR (dev | test | prod)
# ============================================================================
APP_ENV="dev"

# ============================================================================
# 1. Delhi Government Open Transit Database (OTD) Credentials
# Portal: https://otd.delhi.gov.in/ | Docs: https://otd.delhi.gov.in/documentation/
# ============================================================================
OTD_DELHI_API_KEY="your_otd_api_key_here"
OTD_REALTIME_VEHICLE_POSITIONS_URL="https://otd.delhi.gov.in/api/realtime/VehiclePositions.pb"
OTD_DMRC_STATIC_GTFS_DIR="./data/dmrc_gtfs"

# ============================================================================
# 2. ONDC:TRV11 Gateway & BPP Configuration
# ============================================================================
ONDC_GATEWAY_URL="http://localhost:3000"
ONDC_DEFAULT_BPP_ID="bpp.sandbox.ondc.org"
ONDC_DEFAULT_BPP_URI="http://localhost:3000"
ONDC_BAP_ID="bap.metro-agent.agentverse.ai"
ONDC_BAP_URI="http://localhost:8000/beckn"
ONDC_CITY_CODE="std:011"
ONDC_COUNTRY_CODE="IND"
ONDC_UNIQUE_KEY_ID="key-1"
ONDC_SIGNING_PRIVATE_KEY=""
ONDC_HTTP_TIMEOUT="15.0"

# ============================================================================
# 3. Fetch.ai uAgents & Dorado Testnet FET Settlement Configuration
# ============================================================================
COORDINATOR_SEED="metro_bap_coordinator_dev_seed"
CATALOG_AGENT_SEED="metro_bpp_catalog_dev_seed"
TICKETING_AGENT_SEED="metro_bpp_ticketing_dev_seed"
INR_TO_TESTNET_FET="0.01"

# ============================================================================
# 4. ONDC:TRV11 DMRC INR Settlement & BAP Nodal Payout Configuration (RSF 2.0)
# ============================================================================
BAP_SETTLEMENT_TYPE="UPI"
BAP_NODAL_BANK_NAME="YES BANK"
BAP_NODAL_ACCOUNT_NO="000180900001234"
BAP_NODAL_IFSC="YESB0000001"
BAP_NODAL_UPI_VPA="bap.metro-agent@yesbank"

DMRC_DEFAULT_BENEFICIARY_NAME="Delhi Metro Rail Corporation Ltd"
DMRC_DEFAULT_UPI_VPA="dmrc.ondc@sbi"
DMRC_DEFAULT_BANK_ACCOUNT_NO="10891234567"
DMRC_DEFAULT_IFSC_CODE="SBIN0000691"
DMRC_DEFAULT_BANK_NAME="State Bank of India"

INR_PAYOUT_WEBHOOK_URL=""
INR_PAYOUT_API_KEY=""

# ============================================================================
# 5. ASI:One LLM API Configuration (https://api.asi1.ai/v1)
# ============================================================================
ASI_ONE_API_KEY="your_asi_one_api_key_here"
ASI_ONE_BASE_URL="https://api.asi1.ai/v1"
ASI_ONE_MODEL="asi1-mini"

# ============================================================================
# 6. Fetch.ai Agentverse Almanac & Ngrok Public Webhook Endpoint
# ============================================================================
AGENTVERSE_KEY="your_agentverse_jwt_api_token"
AGENT_ENDPOINT="https://your-ngrok-subdomain.ngrok-free.dev"
AGENT_SEED_PHRASE="metro_bap_coordinator_dev_seed_2026"
AGENT_HANDLE="dmrcmetro"
AGENT_NAME="Delhi Metro Ticket Booking"

# ============================================================================
# 7. Agentverse mailbox mode (no ngrok needed). After starting, open the Inspector
# link in the logs, click Connect -> Mailbox, then restart.
# ============================================================================
ENABLE_MAILBOX="false"
# Use private random seeds (python -c "import secrets;print(secrets.token_hex(24))"); the defaults are public.
